# Logs
# Anchored on purpose: a bare `logs` matches ANY directory of that name, which
# silently excluded backend/src/app/api/logs/ — both route files never reached the
# repo, so /api/logs and /api/logs/audit 404'd in production and the audit trail
# pages were dead there while working fine locally.
/logs/
/backend/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel
.env*

# Local SQLite databases (never commit — regenerated via seed/drizzle)
*.db
*.db-shm
*.db-wal
*.db-journal
